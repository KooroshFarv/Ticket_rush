POSTGRES_DB=tickets
POSTGRES_USER=tickets
POSTGRES_PASSWORD=changeme

# Host "postgres" resolves to the postgres service inside docker-compose.
# connection_limit=5 per container (10 total across app1+app2).
# pool_timeout=30s absorbs burst queuing without crashing.
DATABASE_URL=postgresql://tickets:changeme@postgres:5432/tickets?connection_limit=5&pool_timeout=30
